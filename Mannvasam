.timeline{ position:relative; padding-left: 2.2rem; }
.timeline::before{ content:""; position:absolute; left:6px; top:6px; bottom:6px; width:1px; background: var(--line); }
.tl-item{ position:relative; padding-bottom: 2.4rem; }
.tl-item::before{ content:""; position:absolute; left:-2.2rem; top:4px; width:13px; height:13px; border-radius:50%; background: var(--clay); box-shadow: 0 0 0 4px var(--ivory); }
.tl-item h4{ font-size:1.1rem; margin-bottom:.4rem; }
