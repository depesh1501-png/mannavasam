.tl-item p{ color: var(--ink-soft); font-size:.92rem; margin-top:.4rem; max-width:52ch; }

.contact-grid{ display:grid; grid-template-columns: .9fr 1.1fr; gap: 3rem; }
.contact-card{ background: var(--card); border:1px solid var(--line); border-radius: var(--radius-organic); padding:2rem; }
